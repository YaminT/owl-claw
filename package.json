{
  "name": "owl-claw",
  "version": "0.1.0",
  "description": "OwlClaw — a persistent, self-healing task runner for Claude Code and Codex. Queue Markdown instructions, owl runs them.",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "owl-claw": "dist/bin/owl-claw.js",
    "owlclaw": "dist/bin/owl-claw.js",
    "owl": "dist/bin/owl-claw.js"
  },
  "author": "Yamin Tashakkori",
  "files": [
    "dist/bin",
    "dist/src",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "owl-claw": "node dist/bin/owl-claw.js",
    "prepublishOnly": "npm run build",
    "release": "bash scripts/build-release.sh"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "ai",
    "automation",
    "agent",
    "cli",
    "worker",
    "queue"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YaminT/owl-claw.git"
  },
  "homepage": "https://github.com/YaminT/owl-claw",
  "bugs": {
    "url": "https://github.com/YaminT/owl-claw/issues"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.4.0"
  }
}
