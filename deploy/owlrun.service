[Unit]
Description=OwlRun — Claude/Codex instruction runner
Documentation=https://github.com/your-org/owlrun
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=batman
WorkingDirectory=/home/batman/owlRun

Environment=HOME=/home/batman
Environment=OWLRUN_PORT=8090
Environment=OWLRUN_HOST=0.0.0.0
Environment=OWLRUN_INSTRUCTIONS_DIR=/home/batman/owlrun-ins
Environment=OWLRUN_FRONTEND_DIR=/home/batman/frontend-target
Environment=OWLRUN_MAX_RETRIES=20
Environment=OWLRUN_RETRY_INTERVAL=1800
Environment=OWLRUN_PROMPT_RUNS=1
# Uncomment if claude/codex are installed in a non-standard path:
# Environment=PATH=/home/batman/.local/bin:/home/batman/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=PATH=/home/batman/.bun/bin:/usr/local/bin:/usr/bin:/bin

ExecStart=/home/batman/.bun/bin/bun run src/index.ts

Restart=always
RestartSec=5
StandardOutput=append:/home/batman/owlrun.log
StandardError=append:/home/batman/owlrun.log

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/batman/owlrun-ins /home/batman/frontend-target /home/batman/owlrun.log
ProtectHome=read-only
# ReadWritePaths above re-grants write to just the OwlRun working dirs.
PrivateTmp=true

[Install]
WantedBy=multi-user.target
