[Unit]
Description=OwlClaw — Claude/Codex instruction runner
Documentation=https://github.com/your-org/owl-claw
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=batman
WorkingDirectory=/home/batman/owl-claw

Environment=HOME=/home/batman
Environment=OWLCLAW_PORT=8090
Environment=OWLCLAW_HOST=0.0.0.0
Environment=OWLCLAW_INSTRUCTIONS_DIR=/home/batman/owl-claw-ins
Environment=OWLCLAW_FRONTEND_DIR=/home/batman/frontend-target
Environment=OWLCLAW_MAX_RETRIES=20
Environment=OWLCLAW_RETRY_INTERVAL=1800
Environment=OWLCLAW_PROMPT_RUNS=1
# Uncomment if claude/codex are installed in a non-standard path:
# Environment=PATH=/home/batman/.local/bin:/home/batman/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=PATH=/home/batman/.bun/bin:/usr/local/bin:/usr/bin:/bin

ExecStart=/home/batman/.bun/bin/bun run src/index.ts

Restart=always
RestartSec=5
StandardOutput=append:/home/batman/owl-claw.log
StandardError=append:/home/batman/owl-claw.log

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/batman/owl-claw-ins /home/batman/frontend-target /home/batman/owl-claw.log
ProtectHome=read-only
# ReadWritePaths above re-grants write to just the OwlClaw working dirs.
PrivateTmp=true

[Install]
WantedBy=multi-user.target
