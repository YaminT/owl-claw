{
  "name": "owlrun",
  "version": "0.1.0",
  "description": "Persistent local runner for Claude Code / Codex instruction files with a web portal",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "owlrun": "dist/bin/owlrun.js"
  },
  "files": [
    "dist",
    "public",
    "deploy/owlrun.service",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "owlrun": "node dist/bin/owlrun.js",
    "prepublishOnly": "npm run build",
    "release": "bash scripts/build-release.sh"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "ai",
    "automation",
    "agent",
    "cli",
    "worker",
    "queue"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YaminT/owlrunner.git"
  },
  "homepage": "https://github.com/YaminT/owlrunner",
  "bugs": {
    "url": "https://github.com/YaminT/owlrunner/issues"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.4.0"
  }
}
