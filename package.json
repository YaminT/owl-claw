{
  "name": "owl-claw",
  "version": "0.2.0",
  "private": true,
  "description": "Agent Task Runner — queue prompts and run them through a planner → developer → reviewer pipeline",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "bin"
  ],
  "trustedDependencies": [
    "electron"
  ],
  "bin": {
    "owl-claw": "bin/dist/owl.js",
    "owl": "bin/dist/owl.js"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx bin/src/owl.ts",
    "desktop:build": "npm run build -w @owl/web && npm run build -w @owl/desktop",
    "desktop": "npm run desktop:build && npm run start -w @owl/desktop",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.8.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
