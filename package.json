{
  "name": "owlrun",
  "version": "0.1.0",
  "description": "Persistent local runner for Claude/Codex instruction files with a web portal",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "owlrun": "bin/owlrun.ts"
  },
  "files": [
    "bin",
    "src",
    "public",
    "deploy",
    "scripts/build-release.sh",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --hot run src/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "owlrun": "bun run bin/owlrun.ts",
    "release": "bash scripts/build-release.sh"
  },
  "keywords": [
    "claude",
    "codex",
    "cli",
    "ai",
    "automation",
    "worker",
    "bun"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.4.0"
  }
}
