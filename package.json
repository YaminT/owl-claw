{
  "name": "owl-claw",
  "version": "0.1.0",
  "description": "OwlClaw — a persistent, self-healing task runner for Claude Code and Codex. Queue Markdown instructions, owl runs them.",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "owl-claw": "bin/owl-claw.ts",
    "owlclaw": "bin/owl-claw.ts",
    "owl": "bin/owl-claw.ts"
  },
  "files": [
    "bin",
    "src",
    "public",
    "deploy",
    "scripts/build-release.sh",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --hot run src/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "owl-claw": "bun run bin/owl-claw.ts",
    "release": "bash scripts/build-release.sh"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "ai",
    "automation",
    "agent",
    "cli",
    "worker",
    "queue"
  ],
  "author": "Yamin Tashakkori",
  "license": "MIT",
  "engines": {
    "bun": ">=1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YaminT/owl-claw.git"
  },
  "homepage": "https://github.com/YaminT/owl-claw",
  "bugs": {
    "url": "https://github.com/YaminT/owl-claw/issues"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.4.0"
  }
}
